# ==============================================================================
# LORD-PENGUIN (AegisBOM) Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Database Configuration (Optional: defaults to embedded PGlite WebAssembly Postgres if omitted)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegisbom

# PayPal Sandbox Credentials (Required for Live Sandbox settlement)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# Channel3 Multi-Merchant Discovery API (Optional: fallback to seeded product graph)
CHANNEL3_API_KEY=

# KERNEL Cloud Browser API (Optional: fallback to local DOM verification)
KERNEL_API_KEY=

# LLM Orchestrator (Optional: fallback to deterministic project decomposer)
OPENAI_API_KEY=
GEMINI_API_KEY=
